# OpenAlex API key (get one free at https://openalex.org/settings/api)
OPENALEX_API_KEY=your_openalex_key_here

# Crossref polite pool email
CROSSREF_MAILTO=you@example.com

# SQLAlchemy database URL (default: local SQLite)
DB_URL=sqlite:///evidence.db

# Directory for raw JSON response cache
CACHE_DIR=.cache

# ── Phase 2: LLM extraction ──────────────────────────────────────────────────

# Provider: "groq" (default) or "domo" (stub, not yet implemented)
LLM_PROVIDER=groq

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Model to use for extraction (default: qwen/qwen3.8-27b)
EXTRACTION_MODEL=qwen/qwen3.8-27b

# Groq requests-per-minute cap (free tier: 30 RPM)
GROQ_RPM_CAP=30
