# OpenAlex API key (get one free at https://openalex.org/settings/api)
OPENALEX_API_KEY=your_openalex_api_key_here

# Crossref polite pool email
CROSSREF_MAILTO=your-email@example.com

# SQLAlchemy database URL (default: local SQLite)
DB_URL=sqlite:///evidence.db

# Directory for raw JSON response cache
CACHE_DIR=.cache

# LLM Provider configuration
LLM_PROVIDER=domo

# Groq API keys (comma-separated)
GROQ_API_KEYS="your_groq_keys_here"

# Model configuration
EXTRACTION_MODEL=qwen/qwen3.8-27b
ASSESSMENT_MODEL=domo.openai.gpt-4o-mini
LLM_REASONING_EFFORT=low
ASSESSMENT_BATCH_PACE_SECONDS=4

# Domo LLM Configuration
DOMO_BASE_URL=https://your-domo-instance.domo.com/api
DOMO_API_KEY=your_domo_api_key_here
